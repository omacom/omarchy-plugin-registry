<% content_for :title, "#{@plugin.full_name} — Omarchy Plugins" %>
<% content_for :meta_description, @plugin.summary.presence || "#{@plugin.full_name} on the Omarchy plugin registry." %>
<% content_for :social, social_meta(
     title: @plugin.full_name,
     description: @plugin.summary.presence || "#{@plugin.full_name} on the Omarchy plugin registry.",
     image_path: og_plugin_path(@publisher.name, @plugin.name),
     url_path: plugin_path(@publisher.name, @plugin.name)) %>

<%= render "shared/notices", notices: @notices %>

<div class="page-head page-head--plugin" data-controller="detail-back"
     data-detail-back-fallback-url-value="<%= root_path(anchor: 'browse') %>"
     data-action="keydown@window->detail-back#back" aria-keyshortcuts="Backspace">
  <div class="container">
    <div class="page-head__topline">
      <span class="page-head__tab"><%= plugin_card_label(@plugin) %></span>
      <span class="page-head__index" translate="no">PLG-<%= @plugin.id.to_s.rjust(3, "0") %></span>
    </div>
    <h1><span class="ns"><%= link_to @publisher.name, publisher_path(@publisher.name) %>/</span><%= @plugin.name %></h1>
    <p class="summary"><%= @plugin.summary %></p>
    <% if @plugin.category || @plugin.tags.any? %>
      <div class="page-head__chips">
        <% if @plugin.category %>
          <%= link_to Registry::Taxonomy.label(@plugin.category), root_path(category: @plugin.category), class: "chip" %>
        <% end %>
        <% @plugin.tags.each do |tag| %>
          <%= link_to "tag:#{tag}", root_path(tag: tag), class: "chip" %>
        <% end %>
      </div>
    <% end %>
    <div class="page-head__strip">
      <% if @latest %>
        <%= state_badge(:published) %>
        <span translate="no"><span class="diamond" aria-hidden="true">◆</span> v<%= @latest.version %></span>
        <span><%= @latest.license.presence || "No license" %></span>
      <% end %>
      <span><%= compact_number(@plugin.downloads_count) %> downloads</span>
      <span><%= compact_number(@plugin.views_count) %> views</span>
      <% if @plugin.average_rating %>
        <span class="rating-summary"><span class="diamond" aria-hidden="true">◆</span> <%= @plugin.average_rating %>/5
          <span class="muted">(<%= @plugin.ratings_count %>)</span></span>
      <% end %>
      <% if @plugin.kinds.any? %><span translate="no"><%= @plugin.kinds.join(" · ") %></span><% end %>
    </div>
    <% if @latest && @plugin.active? %>
      <div class="install-cmd page-head__install" data-controller="clipboard"
           data-clipboard-text-value="omarchy plugin add <%= @plugin.full_name %>">
        <span class="install-cmd__text"><span class="prompt">$</span> omarchy plugin add <%= @plugin.full_name %></span>
        <%= render "shared/copy_button", label: "Copy install command", text: "copy",
              copied_text: "copied", copied_label: "Install command copied" %>
      </div>
    <% else %>
      <p class="muted page-head__install">Not installable — no version has cleared review.</p>
    <% end %>
  </div>
</div>

<div class="plugin-layout container">
  <article>
    <%
      preview_attachment = if @plugin.preview?
        @plugin.preview_detail.attached? ? @plugin.preview_detail : @plugin.preview_card
      end
      preview_dimensions = if preview_attachment
        @plugin.preview_detail.attached? ? @plugin.preview_detail_meta : @plugin.preview_card_meta
      else
        {}
      end
    %>
    <% if preview_attachment %>
      <div data-controller="lightbox">
        <button class="plugin-preview" type="button" data-action="lightbox#open"
          aria-label="Enlarge <%= @plugin.full_name %> preview">
          <img src="<%= rails_storage_proxy_path(preview_attachment) %>"
            alt="<%= @plugin.full_name %> preview" decoding="async"
            width="<%= preview_dimensions["width"] %>" height="<%= preview_dimensions["height"] %>">
          <span class="plugin-preview__zoom" aria-hidden="true">zoom ↗</span>
        </button>
        <dialog class="lightbox" data-lightbox-target="dialog" data-action="click->lightbox#backdropClose"
          aria-label="<%= @plugin.full_name %> preview">
          <button class="lightbox__close" type="button" data-action="lightbox#close" aria-label="Close preview">×</button>
          <img src="<%= rails_storage_proxy_path(preview_attachment) %>"
            alt="<%= @plugin.full_name %> preview" loading="lazy" decoding="async"
            width="<%= preview_dimensions["width"] %>" height="<%= preview_dimensions["height"] %>">
        </dialog>
      </div>
    <% end %>

    <div class="boxtitle article-title"><span class="glyph" aria-hidden="true">┌─ </span><b>Description</b></div>
    <div class="readme" data-controller="readme-code">
      <% if @plugin.readme.present? %>
        <%= render_markdown @plugin.readme, asset_base: readme_asset_base(@latest) %>
      <% else %>
        <p class="muted">No readme provided.</p>
      <% end %>
    </div>

    <section class="community">
      <h3>Community</h3>

      <% if authenticated? %>
        <%= form_with url: plugin_rating_path(@publisher.name, @plugin.name), class: "rate-widget" do %>
          <span class="eyebrow">Your rating</span>
          <% (1..5).each do |value| %>
            <button type="submit" name="value" value="<%= value %>"
              class="rate-diamond <%= "active" if @my_rating && value <= @my_rating.value %>"
              aria-label="Rate <%= value %> of 5">◆</button>
          <% end %>
        <% end %>
      <% end %>

      <% @comments.each do |comment| %>
        <div class="comment">
          <div class="comment__head">
            <strong><%= comment.user.name || "someone" %></strong>
            <% if @publisher_member_ids.include?(comment.user_id) %><span class="badge">publisher</span><% end %>
            <span class="muted"><%= time_ago_in_words(comment.created_at) %> ago</span>
            <span class="comment__actions">
              <% if authenticated? && comment.user == Current.user %>
                <%= button_to "delete", comment_path(comment), method: :delete, class: "linklike" %>
              <% end %>
              <% if authenticated? && Current.user.admin? && comment.user != Current.user %>
                <%= button_to "hide", hide_admin_comment_path(comment), class: "linklike" %>
              <% end %>
              <% if authenticated? && comment.user != Current.user %>
                <%= button_to "report", reports_path(reportable_type: "Comment", reportable_id: comment.id, reason: "inappropriate"), class: "linklike" %>
              <% end %>
            </span>
          </div>
          <p><%= comment.body %></p>
        </div>
      <% end %>
      <p class="muted u-gap-top-sm"><% if @comments.empty? %>No comments yet.<% end %></p>

      <% if authenticated? %>
        <%= form_with url: plugin_comments_path(@publisher.name, @plugin.name) do %>
          <div class="field">
            <label for="body">Add a comment</label>
            <textarea name="body" id="body" rows="3" required minlength="3" maxlength="2000"></textarea>
          </div>
          <button type="submit" class="button button--small">Post</button>
        <% end %>
      <% else %>
        <p class="muted"><%= link_to "Sign in", new_session_path %> to rate or comment.</p>
      <% end %>
    </section>
  </article>

  <aside class="sidebar">
    <section>
      <h4>Details</h4>
      <dl>
        <dt>Plugin id</dt><dd><code><%= @plugin.manifest_id %></code></dd>
        <% if @latest %>
          <dt>Version</dt><dd><%= @latest.version %></dd>
          <dt>Published</dt><dd><%= time_ago_in_words(@latest.published_at) %> ago</dd>
          <dt>Size</dt><dd><%= number_to_human_size(@latest.size_bytes) %></dd>
          <dt>SHA-256</dt><dd><code><%= @latest.sha256.first(12) %>…</code></dd>
        <% end %>
        <% if (source = source_repo(@plugin.repository_url)) %>
          <dt>Source</dt>
          <dd>
            <%= link_to source[:url], class: "source-link", title: source[:url] do %>
              <%= render "shared/source_icon", icon: source[:icon] %><span><%= source[:label] %></span>
            <% end %>
          </dd>
          <% if @plugin.repo_stars %>
            <dt>Stars</dt><dd>★ <%= compact_number(@plugin.repo_stars) %></dd>
          <% end %>
          <% if @plugin.repo_pushed_at %>
            <dt>Last activity</dt><dd><%= time_ago_in_words(@plugin.repo_pushed_at) %> ago</dd>
          <% end %>
          <% if (release = @plugin.repo_release) %>
            <dt>Release</dt>
            <dd><% if release["release_url"] %><%= link_to release["release_tag"], release["release_url"] %><% else %><%= release["release_tag"] %><% end %></dd>
          <% end %>
        <% end %>
      </dl>
    </section>
    <% if @latest&.capability_fingerprint.present? %>
      <%= render "capabilities", version: @latest %>
    <% end %>
    <% if @latest&.provenance.present? %>
      <%= render "plugins/provenance", provenance: @latest.provenance %>
    <% end %>
    <section>
      <h4>Versions</h4>
      <ul class="version-list">
        <% @versions.each do |version| %>
          <li>
            <%= link_to version.version, plugin_version_path(@publisher.name, @plugin.name, version.version), class: "v" %>
            <span class="muted"><%= version.created_at.to_date %></span>
            <%= state_badge(version.state) unless version.published? %>
          </li>
        <% end %>
        <% if @versions.empty? %><li><span class="muted">No versions yet.</span></li><% end %>
      </ul>
    </section>
  </aside>
</div>
