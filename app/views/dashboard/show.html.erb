<% content_for :title, "Dashboard — Omarchy Hub" %>
<div class="content-page container">
  <p class="eyebrow">Dashboard</p>
  <h1>Hey, <%= @user.name&.split(" ")&.first || @user.email_address %>.</h1>
  <p class="lede">
    <% unless @user.second_factor? %>
      <%= link_to "Add a passkey or enable two-factor auth", settings_two_factor_path %> to unlock publishing.
    <% else %>
      Ready to ship. See the <%= link_to "publishing guide", publishing_path %> for the two-minute walkthrough.
    <% end %>
  </p>

  <% pending_invites = @user.memberships.pending.includes(:publisher) %>
  <% if pending_invites.any? %>
    <section>
      <h2>Invitations</h2>
      <table class="table u-max-mid">
        <tbody>
          <% pending_invites.each do |invite| %>
            <tr>
              <td><strong><%= invite.publisher.name %></strong> invited you as <%= invite.role %></td>
              <td class="actions">
                <%= button_to "Accept", accept_invitation_path(invite), class: "button button--small" %>
                <%= button_to "Decline", decline_invitation_path(invite), class: "button button--ghost button--small" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </section>
  <% end %>

  <% if flash[:minted_token] %>
    <div class="token-reveal" data-controller="clipboard"
         data-clipboard-text-value="<%= flash[:minted_token] %>">
      <p class="eyebrow">Copy this token now — it won't be shown again</p>
      <div class="token-reveal__row">
        <code><%= flash[:minted_token] %></code>
        <%= render "shared/copy_button", label: "Copy token" %>
      </div>
    </div>
  <% end %>

  <p><%= link_to "Compatibility inbox", compatibilities_path %></p>
  <% @publishers.each do |publisher| %>
    <section>
      <h2><%= publisher.name %> <% if publisher.org? %><span class="badge">org</span><% end %></h2>
      <% if publisher.org? && @user.owner_of?(publisher) %>
        <table class="table u-max-narrow u-gap-bottom">
          <thead><tr><th>Member</th><th>Role</th><th></th></tr></thead>
          <tbody>
            <% publisher.memberships.includes(:user).each do |membership| %>
              <tr>
                <td><%= membership.user.name || membership.user.email_address %></td>
                <td><%= membership.role %><%= ' <span class="badge badge--warning">invited</span>'.html_safe if membership.pending? %></td>
                <td class="actions">
                  <%= button_to "Remove", remove_member_org_path(publisher, membership_id: membership.id),
                        class: "button button--ghost button--small" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
        <%= form_with url: invite_member_org_path(publisher), class: "form-inline u-gap-bottom-lg" do %>
          <div class="field">
            <label>Invite member by email</label>
            <input type="email" name="email_address" required placeholder="dev@example.com">
          </div>
          <div class="field">
            <label>Role</label>
            <select name="role" class="select"><option value="publisher">publisher</option><option value="owner">owner</option></select>
          </div>
          <button type="submit" class="button button--small">Invite</button>
        <% end %>
      <% end %>
      <% if publisher.plugins.any? %>
        <table class="table">
          <thead><tr><th>Plugin</th><th>Latest</th><th>Downloads</th><th>State</th></tr></thead>
          <tbody>
            <% publisher.plugins.each do |plugin| %>
              <tr>
                <td><%= link_to plugin.name, package_path(plugin) %></td>
                <td><%= plugin.latest_version || "—" %></td>
                <td><%= compact_number(plugin.downloads_count) %></td>
                <td><%= state_badge(plugin.state) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="muted">No plugins yet in this namespace.</p>
      <% end %>
    </section>
  <% end %>

  <section>
    <h2>Publish tokens</h2>
    <p class="lede">Push-only, scoped to one plugin, and they expire in 7 days — mint a fresh
      one when you need it.</p>
    <% if @tokens.any? %>
      <table class="table">
        <thead><tr><th>Token</th><th>Scope</th><th>Expires</th><th></th></tr></thead>
        <tbody>
          <% @tokens.each do |token| %>
            <tr>
              <td><code><%= token.token_hint %></code></td>
              <td><%= token.scope_label %></td>
              <td><%= time_ago_in_words(token.expires_at) %></td>
              <td class="actions"><%= button_to "Revoke", token_path(token), method: :delete, class: "button button--ghost button--small" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
    <%= form_with url: tokens_path, class: "form-inline" do |form| %>
      <div class="field">
        <label for="publisher_name">Namespace</label>
        <select name="publisher_name" id="publisher_name" class="select">
          <% @publishers.each do |publisher| %><option value="<%= publisher.name %>"><%= publisher.name %></option><% end %>
        </select>
      </div>
      <div class="field">
        <label for="plugin_name">Plugin name</label>
        <input type="text" name="plugin_name" id="plugin_name" required pattern="[a-z0-9][a-z0-9_-]*" placeholder="weather">
      </div>
      <button type="submit" class="button">Mint token</button>
    <% end %>
  </section>

  <section>
    <h2>Trusted publishing</h2>
    <p class="lede">Publish from CI with no stored secret: register a repo + workflow +
      environment once, and tagging a release publishes via OIDC. GitHub Actions today.</p>
    <% trusted = TrustedPublisher.where(publisher: @publishers).includes(:publisher) %>
    <% if trusted.any? %>
      <table class="table">
        <thead><tr><th>Scope</th><th>Repository</th><th>Workflow</th><th>Environment</th><th></th></tr></thead>
        <tbody>
          <% trusted.each do |tp| %>
            <tr>
              <td><%= tp.publisher.name %>/<%= tp.plugin_name %></td>
              <td><code><%= tp.repository %></code></td>
              <td><code><%= tp.workflow %></code></td>
              <td><%= tp.environment %></td>
              <td class="actions"><%= button_to "Remove", trusted_publisher_path(tp), method: :delete, class: "button button--ghost button--small" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
    <%= form_with url: trusted_publishers_path, class: "form-inline" do |form| %>
      <div class="field">
        <label>Namespace</label>
        <select name="publisher_name" class="select">
          <% @publishers.each do |publisher| %><option value="<%= publisher.name %>"><%= publisher.name %></option><% end %>
        </select>
      </div>
      <div class="field">
        <label>Plugin</label>
        <input type="text" name="plugin_name" required pattern="[a-z0-9][a-z0-9_-]*" placeholder="weather">
      </div>
      <div class="field">
        <label>Repository</label>
        <input type="text" name="repository" required placeholder="you/weather">
      </div>
      <div class="field">
        <label>Workflow</label>
        <input type="text" name="workflow" required value=".github/workflows/publish.yml">
      </div>
      <div class="field">
        <label>Environment</label>
        <input type="text" name="environment" value="release">
      </div>
      <button type="submit" class="button">Register</button>
    <% end %>
  </section>

  <section>
    <h2>Organizations</h2>
    <p class="lede"><%= link_to "Create an org", new_org_path %> to share a namespace with a team.</p>
  </section>

  <section>
    <h2>Session</h2>
    <%= button_to "Sign out", session_path, method: :delete, class: "button button--ghost" %>
  </section>
</div>
