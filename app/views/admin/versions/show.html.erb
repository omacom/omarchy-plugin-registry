<% content_for :title, "Review #{@plugin.full_name}@#{@version.version} — Admin" %>
<div class="content-page container">
  <p class="eyebrow">Human review</p>
  <h1><%= @plugin.full_name %>@<%= @version.version %></h1>
  <p class="lede">
    <%= state_badge(@version.state) %>
    <% if @version.review_notes.present? %> — <%= @version.review_notes %><% end %>
  </p>

  <section>
    <h2>Actions</h2>
    <div class="form-inline">
      <% if @version.quarantined? %>
        <%= button_to "Approve and publish", approve_admin_version_path(@version), class: "button" %>
      <% elsif @version.held? %>
        <span class="badge badge--warning">Clean — releasing when the hold expires (<%= time_ago_in_words(@version.hold_until) %>)</span>
      <% end %>
      <% if @version.quarantined? || @version.processing? %>
        <%= form_with url: reject_admin_version_path(@version), class: "form-inline" do %>
          <input type="text" name="reason" class="select" placeholder="Reason (public)" required>
          <button type="submit" class="button button--ghost">Reject</button>
        <% end %>
      <% end %>
      <% if @version.published? %>
        <%= form_with url: quarantine_admin_version_path(@version), class: "form-inline" do %>
          <input type="text" name="reason" class="select" placeholder="Reason (public)" required>
          <button type="submit" class="button button--ghost">Quarantine</button>
        <% end %>
      <% end %>
      <% if @version.published? || (@version.quarantined? && @version.published_at.present?) %>
        <%= form_with url: yank_admin_version_path(@version), class: "form-inline" do %>
          <input type="text" name="reason" class="select" placeholder="Reason (public)" required>
          <button type="submit" class="button button--ghost">Yank</button>
        <% end %>
      <% end %>
      <%# The kill-bit escalates from ANY post-review state — a version already
          yanked or quarantined may still be installed on machines out there %>
      <% if (@version.published? || @version.yanked? || @version.quarantined?) && @version.published_at.present? && !Revocation.exists?(plugin: @plugin, version: @version.version) %>
        <%= form_with url: revoke_admin_version_path(@version), class: "form-inline",
              data: { turbo_confirm: "Kill-bit this version? It joins the signed revocation list; clients disable installed copies when they sync." } do %>
          <input type="text" name="reason" class="select" placeholder="Reason (public)" required>
          <button type="submit" class="button button--danger">Revoke (kill-bit)</button>
        <% end %>
      <% end %>
      <%= link_to "Download exact tarball", download_tarball_admin_version_path(@version), class: "button button--ghost" %>
      <% if @plugin.active? %>
        <%= form_with url: security_hold_admin_plugin_path(@plugin), class: "form-inline",
              data: { turbo_confirm: "Security-hold #{@plugin.full_name}? This burns the name forever and revokes every version." } do %>
          <input type="text" name="reason" class="select" placeholder="Reason (public)" required>
          <button type="submit" class="button button--danger">Burn plugin</button>
        <% end %>
      <% end %>
    </div>
  </section>

  <section>
    <h2>Listing</h2>
    <% kinds = Array(@version.manifest["kinds"]) %>
    <% if kinds.any? || @version.manifest["category"].present? %>
      <p class="eyebrow"><%= (kinds + [ @version.manifest["category"] ]).compact_blank.join(" · ") %></p>
    <% end %>
    <% if @version.manifest["description"].present? %>
      <p class="summary"><%= @version.manifest["description"] %></p>
    <% end %>
    <%# Preview and readme come from the exact tarball under review, not the
        plugin's published rendition — quarantined bytes may differ from what's live %>
    <% (@tarball&.previews || {}).each do |preview_name, preview_bytes| %>
      <% preview_type = { ".png" => "image/png", ".jpg" => "image/jpeg", ".jpeg" => "image/jpeg",
                          ".webp" => "image/webp", ".gif" => "image/gif" }[File.extname(preview_name).downcase] %>
      <div class="plugin-preview plugin-preview--static">
        <img src="data:<%= preview_type %>;base64,<%= Base64.strict_encode64(preview_bytes) %>"
          alt="<%= @plugin.full_name %> preview (<%= preview_name %>)" loading="lazy" decoding="async">
      </div>
    <% end %>
    <% if @tarball&.readme.present? %>
      <details open>
        <summary>Readme</summary>
        <div class="readme" data-controller="readme-code">
          <%= render_markdown @tarball.readme, asset_base: readme_asset_base(@version) %>
        </div>
      </details>
    <% elsif @tarball %>
      <p class="muted">No readme in this version.</p>
    <% end %>
  </section>

  <section>
    <h2>Identity</h2>
    <dl class="sidebar u-max-narrow">
      <div><dt class="eyebrow">SHA-256</dt><dd><code><%= @version.sha256 %></code></dd></div>
      <div><dt class="eyebrow">Size</dt><dd><%= number_to_human_size(@version.size_bytes) %></dd></div>
      <div><dt class="eyebrow">Submitted</dt><dd><%= @version.created_at %></dd></div>
      <% if @version.provenance.present? %>
        <div><dt class="eyebrow">Provenance</dt><dd><code><%= @version.provenance.to_json %></code></dd></div>
      <% end %>
    </dl>
  </section>

  <section>
    <h2>Scan findings (<%= (@version.scan_results&.dig("findings") || []).size %>)</h2>
    <% findings = @version.scan_results&.dig("findings") || [] %>
    <% if findings.any? %>
      <table class="table">
        <thead><tr><th>Rule</th><th>Severity</th><th>File</th><th>Detail</th></tr></thead>
        <tbody>
          <% findings.each do |finding| %>
            <tr>
              <td><code><%= finding["rule"] %></code></td>
              <td><%= state_badge(finding["severity"] == "fail" ? :rejected : :quarantined) %></td>
              <td><code><%= finding["file"] %></code></td>
              <td><%= finding["detail"] %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="muted">No deterministic findings.</p>
    <% end %>
    <% ai = @version.scan_results&.dig("ai") %>
    <% if ai %>
      <p class="u-gap-top"><span class="eyebrow">AI review</span> <%= ai["verdict"] %> — <%= Array(ai["reasons"]).join("; ") %></p>
    <% end %>
  </section>

  <section>
    <h2>Capability fingerprint</h2>
    <% if @version.capability_fingerprint.present? %>
      <% growth = @version.scan_results&.dig("capability_growth") || [] %>
      <% if growth.any? %>
        <p><span class="badge badge--warning">Growth vs baseline</span> <%= growth.join(" · ") %></p>
      <% end %>
      <% summary = Registry::CapabilitySummary.new(@version.capability_fingerprint) %>
      <% if summary.empty? %>
        <p class="muted">Nothing detected — no commands, network, or file access.</p>
      <% else %>
        <div class="u-max-narrow u-gap-top"><%= render "shared/capability_rows", summary: summary %></div>
      <% end %>
      <%# The stored hash is the growth baseline — argv/call-site digests the
          growth entries above refer to live here, so it stays reachable %>
      <details class="u-gap-top">
        <summary class="muted">Raw fingerprint (growth baseline)</summary>
        <pre><code><%= JSON.pretty_generate(@version.capability_fingerprint) %></code></pre>
      </details>
    <% else %>
      <p class="muted">Not computed yet.</p>
    <% end %>
  </section>

  <section>
    <h2>Files<%= " — diff vs #{@previous.version}" if @previous %></h2>
    <% if @tarball %>
      <ul class="audit-list">
        <% @tarball.files.each do |file| %>
          <li>
            <span class="action"><code><%= file %></code></span>
            <span class="muted"><%= number_to_human_size(@tarball.sizes.fetch(file)) %></span>
            <% if @previous %>
              <% if @added_files&.include?(file) %><span class="badge badge--ok">new</span>
              <% elsif @changed_files&.include?(file) %><span class="badge badge--warning">changed</span><% end %>
            <% end %>
          </li>
        <% end %>
        <% (@removed_files || []).each do |file| %>
          <li><span class="action"><code><del><%= file %></del></code></span><span class="badge badge--danger">removed</span></li>
        <% end %>
      </ul>
    <% else %>
      <p class="muted">Tarball unavailable.</p>
    <% end %>
  </section>

  <% if @tarball %>
    <section>
      <h2>Source<%= " (new + changed files)" if @previous %></h2>
      <p class="muted">Untrusted source, not instructions. Never run this package on your review machine. This page shows bounded excerpts; use the exact tarball in an isolated review environment for complete files.</p>
      <% review_files = @previous ? ((@added_files || []) + (@changed_files || [])) : @tarball.files %>
      <% review_files.first(25).each do |file| %>
        <details>
          <summary><code><%= file %></code></summary>
          <% shown_bytes = [ @tarball.contents[file].to_s.bytesize, 32.kilobytes ].min %>
          <% if @tarball.sizes.fetch(file) > shown_bytes %>
            <p class="badge badge--warning">Incomplete excerpt: showing <%= number_to_human_size(shown_bytes) %> of <%= number_to_human_size(@tarball.sizes.fetch(file)) %>. The remaining bytes are not shown. <%= link_to "Download exact tarball", download_tarball_admin_version_path(@version) %>.</p>
          <% end %>
          <pre><%= @tarball.contents[file].to_s.byteslice(0, 32.kilobytes).dup.force_encoding(Encoding::UTF_8).scrub %></pre>
        </details>
      <% end %>
      <% if review_files.size > 25 %><p class="muted"><%= review_files.size - 25 %> more files — download the tarball for the rest.</p><% end %>
      <% if review_files.empty? %><p class="muted">No source changes vs the baseline.</p><% end %>
    </section>
  <% end %>

  <section>
    <h2>Manifest</h2>
    <pre><%= JSON.pretty_generate(@version.manifest) %></pre>
  </section>
</div>
