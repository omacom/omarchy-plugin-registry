<% content_for :title, "Admin — Omarchy Hub" %>
<div class="content-page container">
  <p class="eyebrow">Admin</p>
  <h1>Review queue</h1>
  <p class="lede">Flagged and processing versions land here. Takedown and publish decisions land
    on the public transparency log; comment moderation is logged internally.</p>

  <section>
    <h2>Needs attention (<%= @queue.size %>)</h2>
    <% if @queue.any? %>
      <table class="table">
        <thead><tr><th>Plugin</th><th>Version</th><th>State</th><th>Notes</th><th></th></tr></thead>
        <tbody>
          <% @queue.each do |version| %>
            <tr>
              <td><%= link_to version.plugin.full_name, admin_version_path(version) %></td>
              <td><%= link_to version.version, admin_version_path(version) %></td>
              <td><%= state_badge(version.state) %></td>
              <td class="muted"><%= version.review_notes %></td>
              <td class="actions">
                <% if version.quarantined? %>
                  <%= link_to "Review →", admin_version_path(version), class: "button button--small" %>
                <% else %>
                  <span class="muted">pipeline running…</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="muted">Queue's empty. As designed.</p>
    <% end %>
  </section>

  <section>
    <h2>Recent versions</h2>
    <table class="table">
      <thead><tr><th>Plugin</th><th>Version</th><th>State</th><th>Published</th><th></th></tr></thead>
      <tbody>
        <% @recent_versions.each do |version| %>
          <tr>
            <td><%= version.plugin.full_name %></td>
            <td><%= version.version %></td>
            <td><%= state_badge(version.state) %></td>
            <td class="muted"><%= version.published_at&.strftime("%Y-%m-%d %H:%M") %></td>
            <td class="actions">
              <%= link_to "Review →", admin_version_path(version), class: "button button--ghost button--small" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>

  <section>
    <h2>Reports (<%= @reports.size %>)</h2>
    <% if @reports.any? %>
      <table class="table">
        <thead><tr><th>What</th><th>Reason</th><th>By</th><th></th></tr></thead>
        <tbody>
          <% @reports.each do |report| %>
            <tr>
              <td>
                <% if report.reportable.is_a?(Comment) %>
                  comment on <%= report.reportable.plugin.full_name %>: “<%= report.reportable.body.truncate(80) %>”
                <% else %>
                  <%= report.reportable.try(:full_name) || report.reportable_type %>
                <% end %>
              </td>
              <td><%= report.reason %></td>
              <td class="muted"><%= report.user.name %></td>
              <td class="actions">
                <% if report.reportable.is_a?(Comment) %>
                  <%= button_to "Hide + resolve", resolve_admin_report_path(report, hide: 1), class: "button button--small" %>
                <% end %>
                <%= button_to "Dismiss", resolve_admin_report_path(report), class: "button button--ghost button--small" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="muted">No open reports.</p>
    <% end %>
  </section>

  <section>
    <h2>Kill list (<%= @revocations.size %>)</h2>
    <% if @revocations.any? %>
      <table class="table">
        <thead><tr><th>Plugin</th><th>Version</th><th>Reason</th><th>When</th></tr></thead>
        <tbody>
          <% @revocations.each do |revocation| %>
            <tr>
              <td><%= revocation.plugin.full_name %></td>
              <td><%= revocation.version || "all" %></td>
              <td><%= revocation.reason %></td>
              <td class="muted"><%= revocation.created_at.strftime("%Y-%m-%d") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="muted">Empty — exactly how it should be, almost always.</p>
    <% end %>
  </section>

  <section>
    <h2>Containment</h2>
    <p class="lede">Suspension kills live sessions and revokes scoped tokens immediately;
      lifting a user suspension applies the publish cooldown.</p>
    <div class="form-inline">
      <%= form_with url: admin_suspend_user_path, class: "form-inline" do %>
        <div class="field"><label>User email</label><input type="email" name="email_address" required></div>
        <div class="field"><label>Reason</label><input type="text" name="reason" class="select" required></div>
        <button type="submit" class="button button--danger button--small">Suspend user</button>
      <% end %>
      <%= form_with url: admin_unsuspend_user_path, class: "form-inline" do %>
        <div class="field"><label>User email</label><input type="email" name="email_address" required></div>
        <button type="submit" class="button button--ghost button--small">Lift</button>
      <% end %>
    </div>
    <div class="form-inline">
      <%= form_with url: admin_suspend_publisher_path, class: "form-inline" do %>
        <div class="field"><label>Publisher</label><input type="text" name="name" required></div>
        <div class="field"><label>Reason</label><input type="text" name="reason" class="select" required></div>
        <button type="submit" class="button button--danger button--small">Suspend publisher</button>
      <% end %>
      <%= form_with url: admin_unsuspend_publisher_path, class: "form-inline" do %>
        <div class="field"><label>Publisher</label><input type="text" name="name" required></div>
        <button type="submit" class="button button--ghost button--small">Lift</button>
      <% end %>
    </div>
  </section>

  <section>
    <h2>Recent events</h2>
    <ul class="audit-list">
      <% @recent_events.each do |event| %>
        <li>
          <time><%= event.created_at.strftime("%m-%d %H:%M") %></time>
          <span class="action"><%= event.action %></span>
          <span class="muted"><%= event.user&.name || "system" %> · <%= event.metadata.map { |k, v| "#{k}: #{v}" }.join(" · ") %></span>
        </li>
      <% end %>
    </ul>
  </section>
</div>
