<% content_for :title, "Sign in — Omarchy Hub" %>
<div class="form-page">
  <p class="eyebrow">Sign in</p>
  <h1>No passwords here.</h1>
  <p>Enter your email and we'll send a one-time code. New here? Same door — your account
    is created on first sign-in.</p>
  <%= form_with url: session_path do |form| %>
    <div class="field">
      <label for="email_address">Email</label>
      <input type="email" name="email_address" id="email_address" required autofocus autocomplete="email" placeholder="you@example.com">
    </div>
    <button type="submit" class="button">Email me a code</button>
  <% end %>
  <div data-controller="webauthn"
       data-webauthn-options-url-value="<%= session_passkey_options_path %>"
       data-webauthn-verify-url-value="<%= session_passkey_path %>"
       class="u-gap-top">
    <button type="button" class="button button--ghost" data-action="webauthn#authenticate">Sign in with a passkey</button>
    <p class="field-errors" data-webauthn-target="error"></p>
  </div>
</div>
