<% content_for :title, "Enter code — Omarchy Hub" %>
<div class="form-page">
  <p class="eyebrow">Check your email</p>
  <h1>Enter your code.</h1>
  <p>We sent a 6-digit code to <strong><%= @email_address %></strong>. It expires in 15 minutes.</p>
  <%= form_with url: authenticate_session_path do |form| %>
    <div class="field">
      <label for="code">Code</label>
      <input type="text" name="code" id="code" class="code-input" inputmode="numeric" pattern="[0-9]*" maxlength="6" required autofocus autocomplete="one-time-code">
    </div>
    <button type="submit" class="button">Sign in</button>
  <% end %>
</div>
