<% content_for :title, "Device sign-in — Omarchy Hub" %>
<div class="form-page">
  <p class="eyebrow">CLI sign-in</p>
  <% if @authorization %>
    <h1>Approve this terminal?</h1>
    <p>A device holding code <strong class="code-chip"><%= @authorization.user_code %></strong> wants a
      publish token for your account. Only approve if you just ran
      <code>omarchy plugin publish</code> yourself and the code above matches your terminal.</p>
    <% if @authorization.requested_scope? %>
      <p class="hint">The terminal said it's publishing
        <strong><%= @authorization.requested_publisher_name %>/<%= @authorization.requested_plugin_name %></strong>.</p>
    <% end %>
    <div class="field">
      <label>Grants</label>
      <p class="hint">A push-only token that can publish new versions to any namespace you belong to
        (<%= Current.user.publishers.map(&:name).join(", ").presence || "none yet" %>).
        It's push-only — it can't yank, change owners, or touch account settings — expires in 7 days,
        and every version still goes through review before it can go live.</p>
    </div>
    <%= form_with url: approve_device_path do |form| %>
      <input type="hidden" name="code" value="<%= @authorization.user_code %>">
      <button type="submit" class="button">Approve</button>
      <button type="submit" name="decision" value="deny" class="button button--ghost">Deny</button>
    <% end %>
  <% else %>
    <h1>Enter the code from your terminal.</h1>
    <p><code>omarchy plugin publish</code> shows an 8-character code. Type it here to connect
      that terminal to your account.</p>
    <%= form_with url: device_path, method: :get do |form| %>
      <div class="field">
        <label for="code">Code</label>
        <input type="text" name="code" id="code" class="code-input" maxlength="9" placeholder="XXXX-XXXX" required autofocus autocomplete="off">
      </div>
      <button type="submit" class="button">Continue</button>
    <% end %>
  <% end %>
</div>
