<% content_for :title, "Claim #{@publisher.name} — Omarchy Hub" %>
<div class="form-page u-max-narrow">
  <p class="eyebrow">Claim a seeded namespace</p>
  <h1>Prove it's your repo.</h1>
  <p><strong><%= @publisher.name %></strong> was seeded from
    <a href="<%= @publisher.seed_source_url %>"><%= @publisher.seed_source_url %></a>.
    To claim it, commit a file named <code><%= Registry::RepoProof::CLAIM_FILE %></code> to the
    default branch containing exactly this token:</p>
  <div class="token-reveal" data-controller="clipboard" data-clipboard-text-value="<%= @challenge %>">
    <div class="token-reveal__row">
      <code><%= @challenge %></code>
      <%= render "shared/copy_button", label: "Copy claim token" %>
    </div>
  </div>
  <% if @claim_url %>
    <p class="muted">We'll check <code><%= @claim_url %></code>.</p>
    <%= button_to "Verify and claim", verify_claim_path(@publisher.name), class: "button" %>
  <% else %>
    <p class="field-errors">We don't recognize that forge for raw-file checks. Email
      <a href="mailto:registry@omarchy.org">registry@omarchy.org</a> and a human will verify.</p>
  <% end %>
  <p class="hint u-gap-top-sm">This proof happens once. After the claim, the
    namespace belongs to your account — the repo link becomes plain metadata.</p>
</div>
