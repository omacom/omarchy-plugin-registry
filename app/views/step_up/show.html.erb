<% content_for :title, "Confirm it's you — Omarchy Hub" %>
<div class="form-page">
  <p class="eyebrow">Security check</p>
  <h1>Confirm it's you.</h1>
  <p>This action can mint publish credentials, so we double-check the session — signing in
    isn't enough on its own.</p>

  <% if Current.user.passkeys.any? %>
    <div data-controller="webauthn"
         data-webauthn-options-url-value="<%= step_up_passkey_options_path %>"
         data-webauthn-verify-url-value="<%= step_up_passkey_verify_path %>"
         class="u-gap-bottom-lg">
      <button type="button" class="button" data-action="webauthn#authenticate">Use a passkey</button>
      <p class="field-errors" data-webauthn-target="error"></p>
    </div>
  <% end %>

  <% if Current.user.otp_enabled? %>
    <%= form_with url: step_up_path do |form| %>
      <div class="field u-max-field">
        <label for="code">Code from your authenticator</label>
        <input type="text" name="code" id="code" class="code-input" inputmode="numeric" maxlength="10" required>
      </div>
      <button type="submit" class="button <%= "button--ghost" if Current.user.passkeys.any? %>">Verify</button>
    <% end %>
  <% end %>

  <div class="u-gap-top">
    <% if Current.user.recovery_ready? %>
      <p class="hint">Your recovery window is open — <%= link_to "enroll a replacement factor", settings_two_factor_path %>.</p>
    <% elsif Current.user.recovery_pending? %>
      <p class="hint">Recovery in progress: factor management reopens
        <%= time_ago_in_words(Current.user.recovery_requested_at + User::RECOVERY_DELAY) %> from now.
        Verifying above cancels it.</p>
    <% else %>
      <%= button_to "Lost your factor? Start 72-hour recovery", recovery_path, class: "linklike" %>
    <% end %>
  </div>
</div>
