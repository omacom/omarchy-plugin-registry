<%# Copy control (Lucide `copy` / `check`, ISC license, inlined — no icon
    pipeline in this app). The optional visible labels are used by the plugin
    detail command while compact contexts remain icon-only. %>
<% visible_label = local_assigns[:text].presence %>
<% copied_label = local_assigns[:copied_text].presence || "copied" %>
<button type="button" class="copy-button <%= "copy-button--labeled" if visible_label %> <%= local_assigns[:variant] %>"
        data-clipboard-target="button" data-action="clipboard#copy"
        data-copy-default-label="<%= label %>" data-copy-copied-label="<%= local_assigns[:copied_label].presence || "Copied" %>"
        aria-label="<%= label %>">
  <% if visible_label %><span class="copy-button__copy-label"><%= visible_label %></span><% end %>
  <% if visible_label %><span class="copy-button__done-label"><%= copied_label %></span><% end %>
  <svg class="copy-button__copy" viewBox="0 0 24 24" fill="none" stroke="currentColor"
       stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
    <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
  </svg>
  <svg class="copy-button__check" viewBox="0 0 24 24" fill="none" stroke="currentColor"
       stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M20 6 9 17l-5-5"/>
  </svg>
  <span class="copy-button__tooltip" role="tooltip" aria-hidden="true"><%= label %></span>
</button>
