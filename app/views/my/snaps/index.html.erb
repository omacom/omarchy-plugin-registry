<% content_for :title, "Snaps — My Omarchy" %>
<%= render "my/shared/page_head", crumb: "Snaps", title: "Snaps",
      summary: "Screenshots you've shared. Each link is unguessable and never listed anywhere but here; deleting one kills the link immediately. #{number_to_human_size(@retained)} of #{number_to_human_size(Snap.max_retained_bytes_per_user)} used." %>

<div class="container my-page">
  <% if @snaps.any? %>
    <div class="plugin-grid">
      <% @snaps.each do |snap| %>
        <div class="snap-card__wrap">
          <%= render "my/snaps/card", snap: snap %>
          <%= button_to "Delete", my_snap_path(snap.token), method: :delete, class: "button button--ghost button--small snap-card__delete",
                form: { data: { turbo_confirm: "Delete this snap? The link stops working." } } %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="my-empty">
      <p>Nothing shared yet. In omasnap, hit <kbd>Share</kbd> — or from a terminal:</p>
      <pre>$ omarchy my snap share ~/Pictures/Screenshots/latest.png</pre>
    </div>
  <% end %>
</div>
