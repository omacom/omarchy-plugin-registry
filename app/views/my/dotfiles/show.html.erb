<% content_for :title, "Snapshot — My Omarchy" %>
<% actions = capture do %>
  <%= link_to "Download .tar.gz", download_my_dotfile_path(@bundle), class: "button" %>
  <%= button_to "Delete", my_dotfile_path(@bundle), method: :delete, class: "button button--ghost",
        form: { data: { turbo_confirm: "Delete this snapshot?" } } %>
<% end %>
<%= render "my/shared/page_head", crumb: link_to("Dotfiles", my_dotfiles_path), title: "Snapshot from #{@bundle.device_name.presence || 'a device'}",
      summary: "Pushed #{time_ago_in_words(@bundle.created_at)} ago — #{pluralize(@bundle.file_count, 'file')}, #{number_to_human_size(@bundle.size_bytes)}#{' · encrypted (listing as declared by the client)' if @bundle.encryption_age?}#{" · Omarchy #{@bundle.omarchy_version}" if @bundle.omarchy_version}.",
      actions: actions %>

<div class="container my-page">
  <div class="install-strip" data-controller="clipboard" data-clipboard-text-value="omarchy my sync pull --id <%= @bundle.id %>">
    <span class="install-strip__text"><span class="prompt">$</span> omarchy my sync pull --id <%= @bundle.id %></span>
    <%= render "shared/copy_button", label: "Copy restore command" %>
  </div>
  <p class="muted">SHA-256 <code><%= @bundle.sha256 %></code></p>

  <section class="my-section">
    <h2>Files</h2>
    <% if @bundle.paths.any? %>
      <ul class="path-list">
        <% @bundle.paths.each do |path| %><li><code><%= path %></code></li><% end %>
      </ul>
    <% else %>
      <p class="muted">No listing available.</p>
    <% end %>
  </section>
</div>
