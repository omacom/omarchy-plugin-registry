<% content_for :title, "Omarchy #{@package_type.pluralize.capitalize}" %>
<section class="hero">
  <div class="container hero__inner">
    <%= render "shared/omarchy_wordmark", class: "hero__wordmark", label: "Omarchy" %>
    <% if @package_type == "theme" %>
      <h1 class="page-subtitle">Community themes</h1>
      <p class="hero__lede">Community palettes, scanned releases, and verified downloads — one command away.</p>
    <% else %>
      <h1 class="page-subtitle">Plugin directory</h1>
      <p class="hero__lede">Hosted, scanned, and revocable — every version is immutable, checksummed, and one
        command away. Discovery belongs on a web page. This is the web page.</p>
    <% end %>
    <div class="hero__install" data-controller="clipboard" data-clipboard-text-value="omarchy <%= @package_type || "plugin" %> add publisher/name">
      <code><span class="prompt" aria-hidden="true">$</span> omarchy <%= @package_type || "plugin" %> add <span class="prompt">publisher/name</span></code>
      <%= render "shared/copy_button", label: "Copy install command", variant: "copy-button--inline" %>
    </div>
    <div class="hero__stats">
      <div class="hero__stat"><b><%= @stats.fetch(@package_type.pluralize.to_sym) %></b><span><%= @package_type.pluralize %></span></div>
      <div class="hero__stat"><b><%= @stats[:publishers] %></b><span>publishers</span></div>
      <div class="hero__stat"><b><%= compact_number(@stats[:downloads]) %></b><span>downloads</span></div>
    </div>
  </div>
</section>

<% if @popular&.any? %>
  <section class="showcase" aria-label="Popular <%= @package_type == 'theme' ? 'themes' : 'plugins' %>">
    <div class="container">
      <div class="showcase__head">
        <div>
          <h2 class="showcase__title"><%= @package_type == "theme" ? "A theme for every mood" : "A plugin for every dream, every desire" %></h2>
          <p class="showcase__desc">Explore community <%= @package_type.pluralize %> for Omarchy.
            Don't find what you need?
            Just put your agent on the job, then share when done.</p>
        </div>
        <%= link_to directory_path(sort: "downloads"), class: "showcase__action" do %>
          All <%= @package_type == "theme" ? "themes" : "plugins" %> <span aria-hidden="true">→</span>
        <% end %>
      </div>
      <div class="plugin-grid showcase__grid">
        <%= render partial: "plugin_card", collection: @popular, as: :plugin %>
      </div>
      <div class="showcase__actions">
        <%= link_to directory_path(sort: "downloads"), class: "showcase__action", style: "display:inline-flex" do %>
          All <%= @package_type == "theme" ? "themes" : "plugins" %> <span aria-hidden="true">→</span>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

<% if @recent&.any? %>
  <section class="recent-band" aria-label="Recently added <%= @package_type == 'theme' ? 'themes' : 'plugins' %>">
    <div class="container">
      <div class="recent-band__head">
        <p class="eyebrow">Recently added</p>
        <%= link_to "sort by newest →", directory_path(sort: "newest"), class: "recent-band__more" %>
      </div>
      <div class="recent-band__row">
        <% @recent.each do |plugin| %>
          <%= link_to package_path(plugin), class: "recent-card" do %>
            <span class="recent-card__name"><span class="ns"><%= plugin.publisher.name %>/</span><%= plugin.name %></span>
            <span class="recent-card__summary"><%= plugin.summary %></span>
            <span class="recent-card__meta">v<%= plugin.latest_version %>
              · <%= time_ago_in_words(Time.zone.parse(plugin.first_published_at.to_s)) %> ago</span>
          <% end %>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

<section class="directory container">
  <%= form_with url: directory_path(q: nil, sort: nil, category: nil, tag: nil), method: :get, class: "directory__bar" do %>
    <div class="directory__search">
      <%= render "shared/icon", name: "search" %>
      <input id="directory-search" type="search" name="q" value="<%= @query %>"
        placeholder="Search <%= @package_type.pluralize %>…" aria-label="Search <%= @package_type.pluralize %>"
        spellcheck="false" autocomplete="off" enterkeyhint="search" aria-keyshortcuts="Control+K Meta+K">
      <kbd class="directory__kbd" aria-hidden="true">Ctrl K</kbd>
    </div>
    <% if @category %><input type="hidden" name="category" value="<%= @category %>"><% end %>
    <% if @tag %><input type="hidden" name="tag" value="<%= @tag %>"><% end %>
    <div class="directory__sort">
      <% HomeController::SORTS.each_key do |sort| %>
        <%= link_to sort, directory_path(sort: (sort unless sort == "downloads")), class: ("active" if @sort == sort) %>
      <% end %>
    </div>
  <% end %>

  <% if @category_counts.any? %>
    <nav class="directory__filters" aria-label="Filter by category">
      <%= link_to "All", directory_path(category: nil), class: "chip #{'chip--active' if @category.nil?}" %>
      <% Registry::Taxonomy::CATEGORIES.each do |category| %>
        <% count = @category_counts[category] %>
        <% next unless count %>
        <%= link_to directory_path(category: (category unless @category == category)),
              class: "chip #{'chip--active' if @category == category}" do %>
          <%= Registry::Taxonomy.label(category) %> <span class="chip__count"><%= count %></span>
        <% end %>
      <% end %>
      <% if @tag %>
        <%= link_to directory_path(tag: nil), class: "chip chip--active", title: "Clear tag filter" do %>
          tag:<%= @tag %> <span aria-hidden="true">×</span>
        <% end %>
      <% end %>
    </nav>
  <% end %>

  <% if @query.present? || @category || @tag || @package_type %>
    <p class="muted directory__count" role="status"><%= pluralize(@total, @package_type || "package") %> found</p>
  <% end %>

  <% if @plugins.any? %>
    <div class="plugin-grid" id="directory-grid">
      <%= render partial: "plugin_card", collection: @plugins, as: :plugin %>
    </div>
  <% elsif @page > 1 %>
    <p class="muted">Nothing on this page — <%= link_to "back to the first page", directory_path %>.</p>
  <% else %>
    <p class="muted"><% if @query.present? || @category || @tag %>Nothing matches<%= " “#{@query}”" if @query.present? %> — <%= link_to "clear filters", directory_path(q: nil, sort: nil, category: nil, tag: nil) %>.<% else %>No <%= @package_type.pluralize %> published yet — <%= link_to "be the first", publishing_path %>.<% end %></p>
  <% end %>

  <% if @page > 1 || @more %>
    <div class="form-inline u-gap-top directory__pager">
      <% if @page > 1 %>
        <%= link_to "← Prev", directory_path(page: (@page - 1 if @page - 1 > 1)), class: "button button--ghost button--small" %>
      <% end %>
      <span class="muted">Page <%= @page %></span>
      <% if @more %>
        <%= link_to "Next →", directory_path(page: @page + 1), class: "button button--ghost button--small" %>
      <% end %>
    </div>
  <% end %>
</section>
