<%# Directory + publisher card, ported 1-1 from omarchy-site's PluginCard:
    16:9 preview (monogram fallback), name + stats row, two-line summary,
    type footer — with the registry's own hearts/stars/downloads fields. %>
<%= link_to package_path(plugin), class: "plugin-card" do %>
  <% if plugin.preview? %>
    <img class="plugin-card__preview" src="<%= rails_storage_proxy_path(plugin.preview_card) %>"
      alt="" loading="lazy" decoding="async"
      width="<%= plugin.preview_card_meta["width"] %>" height="<%= plugin.preview_card_meta["height"] %>">
  <% else %>
    <div class="plugin-card__preview--fallback" aria-hidden="true"><%= plugin.name.first(2)&.upcase %></div>
  <% end %>
  <div class="plugin-card__body">
    <div class="plugin-card__head">
      <h3><span class="ns"><%= plugin.publisher.name %>/</span><%= plugin.name %></h3>
      <% if plugin.respond_to?(:repo_stars) && plugin.repo_stars.to_i.positive? %>
        <span class="plugin-card__meta" style="margin: 0 0 0 auto; padding: 0;" title="<%= plugin.repo_stars %> GitHub stars">
          <span class="plugin-card__stat">★ <%= compact_number(plugin.repo_stars) %></span>
        </span>
      <% end %>
    </div>
    <p><%= plugin.summary %></p>
    <div class="plugin-card__meta">
      <% if plugin.latest_version %>
        <span>v<%= plugin.latest_version %></span>
        <span><%= compact_number(plugin.downloads_count) %> downloads</span>
        <% if plugin.category %>
          <span><%= Registry::Taxonomy.label(plugin.category) %></span>
        <% elsif plugin.kinds.any? %>
          <span><%= plugin.kinds.first %></span>
        <% end %>
        <%= card_activity_badge(plugin) %>
      <% else %>
        <span class="badge badge--warning">Under review</span>
      <% end %>
    </div>
  </div>
<% end %>
