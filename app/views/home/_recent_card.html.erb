<% preview_url = plugin.preview? ? rails_storage_proxy_path(plugin.preview_card) : nil %>
<% latest_size = plugin.try(:latest_size_bytes)&.to_i %>
<% card_verified = plugin.installable? %>
<% upvotes = plugin.try(:upvotes_count).to_i %>
<% is_new = plugin.try(:first_published_at).present? && plugin.first_published_at > ApplicationHelper::CARD_RECENCY.ago %>
<% bounded_summary = plugin.summary&.each_char&.take(Registry::ManifestValidator::MAX_DESCRIPTION_LENGTH)&.join %>
<% trend = local_assigns[:trend] || Array.new(PluginCardData::SPARK_DAYS, 0) %>
<% latest_comment = local_assigns[:latest_comment] %>
<% comment_author = nil %>
<% comment_body = nil %>
<% if latest_comment %>
  <% comment_author = bounded_card_text(latest_comment.user.name.presence || "someone", PluginCardData::COMMENT_AUTHOR_LIMIT).presence || "someone" %>
  <% comment_body = bounded_card_text(latest_comment.body, PluginCardData::COMMENT_PREVIEW_LIMIT) %>
  <% latest_comment = nil if comment_body.blank? %>
<% end %>
<% back_id = "wanted-card-back-#{plugin.id}" %>
<article class="recent-card <%= 'recent-card--master' if master %>" style="--pop: <%= delay_ms %>ms"
         data-controller="card-flip" data-action="click->card-flip#toggle keydown->card-flip#keydown"
         data-name="<%= plugin.name %>" data-publisher="<%= plugin.publisher.name %>"
         data-trend="<%= trend.to_json %>" data-recent-rotate-target="card">
  <div class="index-picker__card-inner">
    <div class="index-picker__card-face index-picker__card-face--front recent-card__front"
         data-card-flip-target="front" aria-hidden="false">
      <%= link_to "", plugin_path(plugin.publisher.name, plugin.name), class: "recent-card__open",
            aria: { label: "Open details for #{plugin.full_name}" },
            data: { action: "pointerdown->plugin-share#departByPointer" } %>
      <span class="recent-card__visual">
        <% if preview_url %>
          <img class="recent-card__art" src="<%= preview_url %>" alt="" loading="lazy" decoding="async"
               width="<%= plugin.preview_card_meta['width'] %>" height="<%= plugin.preview_card_meta['height'] %>">
        <% else %>
          <span class="recent-card__art recent-card__art--fallback discovery-preview-fallback" aria-hidden="true">[ preview unavailable ]</span>
        <% end %>
        <span class="index-picker__card-author recent-card__author" translate="no" aria-label="Publisher: <%= plugin.publisher.name %>">
          <span><%= plugin.publisher.name.downcase %></span>
        </span>
      </span>
      <span class="recent-card__foot">
        <span class="recent-card__primary">
          <%= link_to plugin.name, plugin_path(plugin.publisher.name, plugin.name),
                class: "recent-card__name", translate: "no",
                data: { share_label: "Copy link to #{plugin.full_name}", action: "pointerdown->plugin-share#pointerInteraction click->plugin-share#copy keydown.space->plugin-share#copy",
                        share_url: plugin_path(plugin.publisher.name, plugin.name) } %>
          <span class="recent-card__signals">
            <span class="visually-hidden"><%= pluralize(plugin.downloads_count, 'download') %>, <%= pluralize(upvotes, 'upvote') %>, <%= pluralize(plugin.views_count, 'view') %></span>
            <span aria-hidden="true">↓ <%= compact_number(plugin.downloads_count) %></span>
            <span aria-hidden="true"><svg class="index-picker__upvote-glyph" viewBox="0 0 16 16" focusable="false"><path d="M5.5 7 8 2.5c.3-.6 1.2-.4 1.2.3V6h3.2c.8 0 1.4.7 1.2 1.5l-1 5c-.1.6-.6 1-1.2 1H5.5m0-6.5v6.5H2.5V7h3Z"/></svg> <%= compact_number(upvotes) %></span>
            <span aria-hidden="true"><svg class="index-picker__view-glyph" viewBox="0 0 16 16" focusable="false"><path d="M1.5 8s2.3-4 6.5-4 6.5 4 6.5 4-2.3 4-6.5 4S1.5 8 1.5 8Z"/><circle cx="8" cy="8" r="1.7"/></svg> <%= compact_number(plugin.views_count) %></span>
          </span>
        </span>
        <span class="recent-card__secondary">
          <span class="recent-card__publisher" translate="no"><%= plugin.publisher.name %></span>
          <span class="recent-card__artifact" translate="no">
            <b class="<%= card_verified ? 'is-verified' : 'is-pending' %>"
               aria-label="<%= card_verified ? 'Verified plugin' : 'Plugin verification pending' %>"><%= card_verified ? "Verified" : "Pending" %></b>
            <% if latest_size.present? %><span><%= compact_byte_size(latest_size) %></span><% end %>
            <span>v<%= plugin.latest_version %></span>
          </span>
        </span>
        <span class="recent-card__summary"><%= plugin.summary %></span>
      </span>
      <button type="button"
              class="index-picker__card-flip index-picker__card-flip--<%= card_verified ? 'verified' : 'pending' %> recent-card__badge recent-card__badge--toggle"
              aria-expanded="false" aria-controls="<%= back_id %>"
              aria-label="<%= is_new ? 'New' : 'Updated' %>, <%= card_verified ? 'verified' : 'pending' %> plugin. Show quick details for <%= plugin.full_name %>"
              data-card-flip-target="toggle" data-action="card-flip#toggleButton">
        <span class="index-picker__card-flip-lifecycle<%= ' is-new' if is_new %>" aria-hidden="true"><%= is_new ? "new" : "updated" %></span>
        <span class="index-picker__card-flip-separator" aria-hidden="true">|</span>
        <span class="index-picker__card-flip-status" aria-hidden="true"><%= card_verified ? "verified" : "pending" %></span>
      </button>
      <span class="index-picker__card-flip index-picker__card-flip--<%= card_verified ? 'verified' : 'pending' %> recent-card__badge recent-card__badge--status"
            aria-label="<%= is_new ? 'New' : 'Updated' %>, <%= card_verified ? 'verified' : 'pending' %> plugin">
        <span class="index-picker__card-flip-lifecycle<%= ' is-new' if is_new %>" aria-hidden="true"><%= is_new ? "new" : "updated" %></span>
        <span class="index-picker__card-flip-separator" aria-hidden="true">|</span>
        <span class="index-picker__card-flip-status" aria-hidden="true"><%= card_verified ? "verified" : "pending" %></span>
      </span>
    </div>

    <%= render "home/plugin_card_back", plugin:, back_id:, trend:, upvotes:, bounded_summary:,
          latest_comment:, comment_author:, comment_body: %>
  </div>
</article>
