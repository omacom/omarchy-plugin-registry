<% preview_url = plugin.preview? ? rails_storage_proxy_path(plugin.preview_card) : nil %>
<% latest_size = plugin.try(:latest_size_bytes)&.to_i %>
<% upvotes = plugin.try(:upvotes_count).to_i %>
<% is_new = plugin.try(:first_published_at).present? && plugin.first_published_at > ApplicationHelper::CARD_RECENCY.ago %>
<article class="recent-card <%= 'recent-card--master' if master %>" style="--pop: <%= delay_ms %>ms"
         data-recent-rotate-target="card">
  <%= link_to "", plugin_path(plugin.publisher.name, plugin.name), class: "recent-card__open",
        aria: { label: "Open details for #{plugin.full_name}" },
        data: { action: "pointerdown->plugin-share#departByPointer" } %>
  <span class="recent-card__visual">
    <% if preview_url %>
      <img class="recent-card__art" src="<%= preview_url %>" alt="" loading="lazy" decoding="async"
           width="<%= plugin.preview_card_meta['width'] %>" height="<%= plugin.preview_card_meta['height'] %>">
    <% else %>
      <span class="recent-card__art recent-card__art--fallback discovery-preview-fallback" aria-hidden="true">[ preview unavailable ]</span>
    <% end %>
  </span>
  <span class="recent-card__foot">
    <span class="recent-card__primary">
      <%= link_to plugin.name, plugin_path(plugin.publisher.name, plugin.name),
            class: "recent-card__name", translate: "no",
            data: { share_label: "Copy link to #{plugin.full_name}", action: "pointerdown->plugin-share#pointerInteraction click->plugin-share#copy keydown.space->plugin-share#copy",
                    share_url: plugin_path(plugin.publisher.name, plugin.name) } %>
      <span class="recent-card__signals">
        <span class="visually-hidden"><%= "New plugin, " if is_new %><%= pluralize(plugin.downloads_count, 'download') %>, <%= pluralize(upvotes, 'upvote') %>, <%= pluralize(plugin.views_count, 'view') %></span>
        <% if is_new %><mark aria-hidden="true">new</mark><% end %>
        <span aria-hidden="true">↓ <%= compact_number(plugin.downloads_count) %></span>
        <span aria-hidden="true"><svg class="index-picker__upvote-glyph" viewBox="0 0 16 16" focusable="false"><path d="M5.5 7 8 2.5c.3-.6 1.2-.4 1.2.3V6h3.2c.8 0 1.4.7 1.2 1.5l-1 5c-.1.6-.6 1-1.2 1H5.5m0-6.5v6.5H2.5V7h3Z"/></svg> <%= compact_number(upvotes) %></span>
        <span aria-hidden="true"><svg class="index-picker__view-glyph" viewBox="0 0 16 16" focusable="false"><path d="M1.5 8s2.3-4 6.5-4 6.5 4 6.5 4-2.3 4-6.5 4S1.5 8 1.5 8Z"/><circle cx="8" cy="8" r="1.7"/></svg> <%= compact_number(plugin.views_count) %></span>
      </span>
    </span>
    <span class="recent-card__secondary">
      <span class="recent-card__publisher" translate="no"><%= plugin.publisher.name %></span>
      <span class="recent-card__artifact" translate="no">
        <b class="<%= latest_size.present? ? 'is-verified' : 'is-pending' %>"
           aria-label="<%= latest_size.present? ? 'Verified artifact: passed registry review' : 'Artifact verification pending' %>"><%= latest_size.present? ? "Verified" : "Pending" %></b>
        <% if latest_size.present? %><span><%= compact_byte_size(latest_size) %></span><% end %>
        <span>v<%= plugin.latest_version %></span>
      </span>
    </span>
    <span class="recent-card__summary"><%= plugin.summary %></span>
  </span>
</article>
