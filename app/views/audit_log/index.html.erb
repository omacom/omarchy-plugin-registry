<% content_for :title, "Transparency log — Omarchy Hub" %>
<div class="content-page container">
  <p class="eyebrow">Transparency</p>
  <h1>Audit log</h1>
  <p class="lede">Every publish, yank, takedown, and namespace claim — in public. The index
    itself is mirrorable; this is the human-readable view.</p>
  <ul class="audit-list">
    <% @events.each do |event| %>
      <li>
        <time datetime="<%= event.created_at.iso8601 %>"><%= event.created_at.strftime("%Y-%m-%d %H:%M UTC") %></time>
        <span class="action"><%= event.action %></span>
        <span><%= event.metadata.map { |k, v| "#{k}: #{v}" }.join(" · ") %></span>
      </li>
    <% end %>
    <% if @events.empty? %><li><span class="muted">Nothing yet.</span></li><% end %>
  </ul>
  <div class="form-inline u-gap-top">
    <% if @page > 1 %><%= link_to "← Newer", audit_log_path(page: @page - 1), class: "button button--ghost button--small" %><% end %>
    <% if @more %><%= link_to "Older →", audit_log_path(page: @page + 1), class: "button button--ghost button--small" %><% end %>
  </div>
</div>
