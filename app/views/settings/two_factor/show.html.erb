<% content_for :title, "Account security — Omarchy Hub" %>
<div class="content-page container">
  <p class="eyebrow">Account security</p>
  <h1>Second factor</h1>
  <p class="lede">Required before you can publish — every registry credential incident starts
    with a phished account. A passkey is the strongest option (unphishable); TOTP works too.</p>

  <section>
    <h2>Passkeys</h2>
    <% if @user.passkeys.any? %>
      <table class="table u-max-mid">
        <thead><tr><th>Name</th><th>Last used</th><th></th></tr></thead>
        <tbody>
          <% @user.passkeys.each do |passkey| %>
            <tr>
              <td><%= passkey.nickname %></td>
              <td class="muted"><%= passkey.last_used_at ? "#{time_ago_in_words(passkey.last_used_at)} ago" : "never" %></td>
              <td class="actions"><%= button_to "Remove", settings_passkey_path(passkey), method: :delete, class: "button button--ghost button--small" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
    <div data-controller="webauthn"
         data-webauthn-options-url-value="<%= options_settings_passkeys_path %>"
         data-webauthn-verify-url-value="<%= settings_passkeys_path %>">
      <button type="button" class="button" data-action="webauthn#register">Add a passkey</button>
      <p class="field-errors" data-webauthn-target="error"></p>
    </div>
  </section>

  <section>
    <h2>Authenticator app (TOTP)</h2>
    <% if @user.otp_enabled? %>
      <p class="lede">Enabled.
        <%= button_to "Disable TOTP", settings_two_factor_path, method: :delete, class: "button button--ghost button--small",
              form: { data: { turbo_confirm: "Disable TOTP? Your backup codes stop working; re-enrolling generates a fresh secret." } } %>
      </p>
      <% if @backup_codes.present? %>
        <h4 class="u-gap-bottom-sm">Backup codes — shown once, save them now</h4>
        <p class="lede">Each works once if you lose your authenticator. They will not be displayed again.</p>
        <ul class="backup-codes">
          <% @backup_codes.each do |code| %><li><code><%= code %></code></li><% end %>
        </ul>
      <% end %>
    <% else %>
      <p class="lede">Scan with any TOTP app, then confirm with a code.</p>
      <div class="qr-box"><%= @qr_svg.html_safe %></div>
      <p class="muted" data-controller="clipboard" data-clipboard-text-value="<%= @provisional_secret %>">
        Or enter the secret manually: <code><%= @provisional_secret %></code>
        <%= render "shared/copy_button", label: "Copy TOTP secret", variant: "copy-button--inline" %>
      </p>
      <%= form_with url: settings_two_factor_path, method: :patch do |form| %>
        <div class="field u-max-field u-gap-top">
          <label for="code">Code from your app</label>
          <input type="text" name="code" id="code" class="code-input" inputmode="numeric" maxlength="6" required>
        </div>
        <button type="submit" class="button">Enable</button>
      <% end %>
    <% end %>
  </section>
</div>
